# Seed local config (no secrets committed; guardian address + scratch root).
# Copy to .env and adjust paths. SEED_STATE_DIR is test-only.
SEED_GUARDIAN_URL=http://127.0.0.1:7788
SEED_SCRATCH_ROOT=$HOME/.seed/scratch

# Model turns (`seed run`, and prompts in an interactive session) fail loudly
# without a key. Uncomment and set your own; never commit a real value.
# OPENROUTER_API_KEY=

# Interactive frontend options.
# Mouse reporting is off by default because enabling it switches to the
# alternate screen and gives up your terminal's own scrollback.
# SEED_TUI_MOUSE=1