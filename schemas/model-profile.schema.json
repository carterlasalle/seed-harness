{
  "$comment": "Seed schema. Model profiler record (spec section 85: per-model strengths/cost/latency). [trace:v1 id=impl.schemas work=WORK-SEED-6VF90M7B satisfies=REQ-SEED-AJZXZFBN satisfies=REQ-SEED-D5V8QCMS]",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeedModelProfile",
  "type": "object",
  "required": [
    "model",
    "strengths",
    "weaknesses"
  ],
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "costPerTask": {
      "type": "number",
      "minimum": 0
    },
    "p50LatencyMs": {
      "type": "number",
      "minimum": 0
    },
    "tasksEvaluated": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
