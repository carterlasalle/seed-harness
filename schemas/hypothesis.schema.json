{
  "$comment": "Seed schema. Scientist hypothesis triple (spec: 3-hypothesis scientist validates this shape). [trace:v1 id=impl.schemas work=WORK-SEED-6VF90M7B satisfies=REQ-SEED-AJZXZFBN satisfies=REQ-SEED-D5V8QCMS]",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeedHypothesis",
  "type": "object",
  "required": [
    "id",
    "statement",
    "prediction",
    "falsification",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "prediction": {
      "type": "string",
      "minLength": 1
    },
    "falsification": {
      "type": "string",
      "description": "Observation that would disprove it"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "supported",
        "refuted"
      ]
    }
  },
  "additionalProperties": false
}
